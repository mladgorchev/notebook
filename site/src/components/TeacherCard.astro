---
import type { CollectionEntry } from 'astro:content';

interface Props {
	teacher: CollectionEntry<'teachers'>;
	count?: number;
}
const { teacher, count } = Astro.props;
const { data } = teacher;
---
<a class="teacher panel" href={`/uchiteli/${teacher.id}/`}>
	{data.tradition && <span class="kicker">{data.tradition}</span>}
	<h3>{data.name}</h3>
	<span class="date">
		{data.dates}{count !== undefined && ` · ${count} ${count === 1 ? 'превод' : 'превода'}`}
	</span>
</a>

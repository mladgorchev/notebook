---
import { getEntry } from 'astro:content';
import Cover from './Cover.astro';
import { excerptOf, formatDate, readingTime, type Translation } from '../lib/utils';

interface Props {
	entry: Translation;
}
const { entry } = Astro.props;
const { data } = entry;
const teacher = data.teacher ? await getEntry(data.teacher) : undefined;
---
<a class="card" href={`/${entry.id}/`}>
	<Cover title={data.title} tradition={data.tradition} image={data.cover} />
	<div class="card-body">
		{data.tradition && <span class="eyebrow">{data.tradition}</span>}
		<h3>{data.title}</h3>
		<p>{excerptOf(entry, 140)}</p>
		<div class="meta">
			{teacher && <span>{teacher.data.name}</span>}
			{teacher && <span class="dot" />}
			<time datetime={data.date.toISOString()}>{formatDate(data.date)}</time>
			<span class="dot" />
			<span>{readingTime(entry.body)} мин</span>
		</div>
	</div>
</a>

---
interface Props {
	current: number;
	last: number;
	base: string; // e.g. '/prevodi/'
}
const { current, last, base } = Astro.props;
const href = (n: number) => (n === 1 ? base : `${base}${n}/`);

// Show first, last, and the pages around the current one.
const pages: (number | '…')[] = [];
for (let n = 1; n <= last; n++) {
	if (n === 1 || n === last || Math.abs(n - current) <= 1) pages.push(n);
	else if (pages.at(-1) !== '…') pages.push('…');
}
---
{last > 1 && (
	<nav class="pagination" aria-label="Страници">
		<a class="btn" href={current > 1 ? href(current - 1) : undefined} aria-disabled={current === 1 ? 'true' : undefined}>‹ Назад</a>
		{pages.map((p) =>
			p === '…' ? (
				<span class="gap">…</span>
			) : (
				<a class="btn" href={href(p)} aria-current={p === current ? 'page' : undefined}>{p}</a>
			)
		)}
		<a class="btn" href={current < last ? href(current + 1) : undefined} aria-disabled={current === last ? 'true' : undefined}>Напред ›</a>
	</nav>
)}

---
import Icon from './Icon.astro';

const sections = [
	{ href: '/prevodi/', label: 'Преводи' },
	{ href: '/uchiteli/', label: 'Учители' },
	{ href: '/temi/', label: 'Теми' },
	{ href: '/tarsene/', label: 'Търсене' },
	{ href: '/za-nas/', label: 'За нас' },
];
const path = Astro.url.pathname.replace(/\/?$/, '/');
---
<header class="site-header">
	<div class="wrap">
		<div class="masthead">
			<div class="masthead-left">
				<button class="icon-btn menu-toggle" id="menu-toggle" type="button" aria-label="Меню" aria-controls="site-sections" aria-expanded="false">
					<Icon name="menu" size={24} />
				</button>
				<a class="icon-btn" href="/tarsene/" aria-label="Търсене"><Icon name="search" /></a>
				<a class="text-link" href="/za-nas/">За нас</a>
			</div>
			<a class="brand" href="/">
				<span class="brand-tag">Будистки текстове на български</span>
				<span class="brand-name">Дхарма Слово</span>
			</a>
			<div class="masthead-right">
				<button class="icon-btn" id="theme-toggle" type="button" aria-label="Светла или тъмна тема">
					<span class="theme-dark"><Icon name="moon" /></span>
					<span class="theme-light" hidden><Icon name="sun" /></span>
				</button>
				<a class="btn btn-solid" href="/prevodi/">Всички преводи</a>
			</div>
		</div>
		<nav class="sections" id="site-sections" aria-label="Раздели">
			{sections.map((s) => (
				<a href={s.href} aria-current={path.startsWith(s.href) ? 'page' : undefined}>{s.label}</a>
			))}
		</nav>
	</div>
</header>

<script>
	const root = document.documentElement;
	const btn = document.getElementById('theme-toggle')!;
	const isDark = () =>
		root.dataset.theme === 'dark' ||
		(!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
	const sync = () => {
		btn.querySelector<HTMLElement>('.theme-dark')!.hidden = isDark();
		btn.querySelector<HTMLElement>('.theme-light')!.hidden = !isDark();
	};
	sync();
	btn.addEventListener('click', () => {
		root.dataset.theme = isDark() ? 'light' : 'dark';
		try { localStorage.setItem('theme', root.dataset.theme); } catch {}
		sync();
	});

	const menu = document.getElementById('menu-toggle')!;
	const nav = document.getElementById('site-sections')!;
	menu.addEventListener('click', () => {
		const open = nav.dataset.open !== 'true';
		nav.dataset.open = String(open);
		menu.setAttribute('aria-expanded', String(open));
	});
</script>

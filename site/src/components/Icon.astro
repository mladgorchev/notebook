---
// Small inline icon set, so the site loads no icon fonts.
interface Props {
	name: 'wheel' | 'search' | 'sun' | 'moon' | 'menu' | 'chevron' | 'book' | 'person' | 'tag' | 'rss';
	size?: number;
}
const { name, size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
	{name === 'wheel' && (
		<>
			<circle cx="12" cy="12" r="8.5" />
			<circle cx="12" cy="12" r="2.2" />
			<path d="M12 3.5v6.3M12 14.2v6.3M3.5 12h6.3M14.2 12h6.3M6 6l4.4 4.4M13.6 13.6 18 18M18 6l-4.4 4.4M10.4 13.6 6 18" />
		</>
	)}
	{name === 'search' && (<><circle cx="11" cy="11" r="6.5" /><path d="m20 20-4.2-4.2" /></>)}
	{name === 'sun' && (<><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M4.6 4.6 6 6M18 18l1.4 1.4M2.5 12h2M19.5 12h2M4.6 19.4 6 18M18 6l1.4-1.4" /></>)}
	{name === 'moon' && <path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5Z" />}
	{name === 'menu' && <path d="M4 7h16M4 12h16M4 17h16" />}
	{name === 'chevron' && <path d="m9 6 6 6-6 6" />}
	{name === 'book' && <path d="M4 5.5C6.5 4.5 9.5 4.5 12 6c2.5-1.5 5.5-1.5 8-.5v13c-2.5-1-5.5-1-8 .5-2.5-1.5-5.5-1.5-8-.5v-13ZM12 6v13" />}
	{name === 'person' && (<><circle cx="12" cy="8" r="3.5" /><path d="M5 20c1-3.8 3.8-5.5 7-5.5s6 1.7 7 5.5" /></>)}
	{name === 'tag' && (<><path d="M3.5 12.5V4.5a1 1 0 0 1 1-1h8l8 8-9 9-8-8Z" /><circle cx="8" cy="8" r="1.4" /></>)}
	{name === 'rss' && (<><path d="M5 5a14 14 0 0 1 14 14M5 11a8 8 0 0 1 8 8" /><circle cx="6" cy="18" r="1" /></>)}
</svg>

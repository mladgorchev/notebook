---
// One translation shown in one of the layouts used across the site.
import { getEntry } from 'astro:content';
import Cover from './Cover.astro';
import { excerptOf, publishedLabel, slugify, type Translation } from '../lib/utils';

interface Props {
	entry: Translation;
	variant: 'lead' | 'second' | 'headline' | 'card';
}
const { entry, variant } = Astro.props;
const { data } = entry;
const teacher = data.teacher ? await getEntry(data.teacher) : undefined;
const href = `/${entry.id}/`;
const by = teacher?.data.name;
---
{variant === 'lead' && (
	<a class="lead-story" href={href}>
		<Cover tradition={data.tradition} image={data.cover} />
		<div class="story-text">
			{data.tradition && <span class="kicker">{data.tradition}</span>}
			<h2>{data.title}</h2>
			<p>{excerptOf(entry, 200)}</p>
			{by && <span class="byline">{by}</span>}
		</div>
	</a>
)}
{variant === 'second' && (
	<a class="second-story" href={href}>
		<Cover tradition={data.tradition} image={data.cover} />
		<div>
			<h3>{data.title}</h3>
			{by && <span class="byline">{by}</span>}
		</div>
	</a>
)}
{variant === 'headline' && (
	<a class="headline" href={href}>
		{data.tradition && <span class="kicker">{data.tradition}</span>}
		<h3>{data.title}</h3>
		{by && <span class="byline">{by}</span>}
	</a>
)}
{variant === 'card' && (
	<article class="card panel">
		<div class="card-text">
			<a class="card-title" href={href}>{data.title}</a>
			<div class="card-sub">
				{[by, data.subtitle].filter(Boolean).join(' · ')}
			</div>
			<p>{excerptOf(entry, 260)}</p>
			<div class="card-foot">
				<span><b>Превод:</b> {data.translator}</span>
				<span><b>Публикуван:</b> {publishedLabel(data.date)}</span>
			</div>
		</div>
		<a href={href} tabindex="-1" aria-hidden="true"><Cover tradition={data.tradition} image={data.cover} /></a>
		<dl class="facts">
			{data.tradition && <div><dt>Традиция</dt><dd>{data.tradition}</dd></div>}
			{teacher && <div><dt>Учител</dt><dd><a href={`/uchiteli/${teacher.id}/`}>{teacher.data.name}</a></dd></div>}
			{data.original_language && <div><dt>Оригинал</dt><dd>{data.original_language}</dd></div>}
			{data.tags.length > 0 && (
				<div><dt>Теми</dt><dd>{data.tags.slice(0, 4).map((tag) => <a href={`/temi/${slugify(tag)}/`}>{tag}</a>)}</dd></div>
			)}
		</dl>
	</article>
)}

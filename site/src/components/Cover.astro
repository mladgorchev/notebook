---
// A text's cover image, or a flat panel in the tradition's pigment with an emblem.
import Icon from './Icon.astro';
import { pigmentFor } from '../lib/utils';

interface Props {
	tradition?: string;
	image?: string;
	initial?: string;
}
const { tradition, image, initial } = Astro.props;
---
<div class="cover" style={`--hue: ${pigmentFor(tradition)}`}>
	{image ? <img src={image} alt="" loading="lazy" /> : initial ? <span>{initial}</span> : <Icon name="wheel" size={64} />}
</div>

---
// A text's cover image, or a flat panel in the tradition's colour with an emblem.
import Icon from './Icon.astro';

interface Props {
	tradition?: string;
	image?: string;
}
const { tradition, image } = Astro.props;

const hues: Record<string, string> = {
	'Тхеравада': '#b8611c',
	'Махаяна': '#801c4a',
	'Ваджраяна': '#21409a',
	'Дзен': '#006176',
};
const hue = (tradition && hues[tradition]) || '#5a4a3f';
---
<div class="cover" style={`--hue: ${hue}`}>
	{image ? <img src={image} alt="" loading="lazy" /> : <Icon name="wheel" size={64} />}
</div>

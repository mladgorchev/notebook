---
import Icon from './Icon.astro';
import Seal from './Seal.astro';

const year = new Date().getFullYear();
---
<section class="follow">
	<div class="wrap">
		<strong>Следете новите преводи</strong>
		<a class="btn" href="/rss.xml"><Icon name="rss" size={16} /> RSS абонамент</a>
	</div>
</section>
<footer class="site-footer">
	<div class="wrap">
		<Seal />
		<nav class="footer-links" aria-label="Долно меню">
			<a href="/prevodi/">Преводи</a>
			<a href="/uchiteli/">Учители</a>
			<a href="/temi/">Теми</a>
			<a href="/tarsene/">Търсене</a>
			<a href="/za-nas/">За нас</a>
		</nav>
		<div class="footer-copy">
			© {year} Дхарма Слово<br />
			Преводите са собственост на своите преводачи.
		</div>
	</div>
</footer>

---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Story from '../../components/Story.astro';
import { getTranslations, slugify } from '../../lib/utils';

export async function getStaticPaths() {
	const teachers = await getCollection('teachers');
	return teachers.map((teacher) => ({ params: { id: teacher.id }, props: { teacher } }));
}

const { teacher } = Astro.props;
const { data } = teacher;
const { Content } = await render(teacher);
const works = (await getTranslations()).filter((t) => t.data.teacher?.id === teacher.id);
const topics = [...new Set(works.flatMap((w) => w.data.tags))];
---
<Base title={data.name} description={data.summary}>
	<div class="wrap">
		<article class="article panel">
			<header class="article-head">
				<span class="kicker">
					<a href="/uchiteli/">Учители</a>
					{data.tradition && <><span class="sep">|</span>{data.tradition}</>}
				</span>
				<h1>{data.name}</h1>
				{data.dates && <div class="byline">{data.dates}</div>}
			</header>
			<div class="bio-body">
				<aside class="meta-side">
					<dl class="facts">
						{data.tradition && <div><dt>Традиция</dt><dd>{data.tradition}</dd></div>}
						{data.dates && <div><dt>Години</dt><dd>{data.dates}</dd></div>}
						{data.region && <div><dt>Регион</dt><dd>{data.region}</dd></div>}
						<div><dt>Преводи</dt><dd>{works.length}</dd></div>
						{topics.length > 0 && (
							<div><dt>Теми</dt><dd>{topics.slice(0, 8).map((tag) => <a href={`/temi/${slugify(tag)}/`}>{tag}</a>)}</dd></div>
						)}
					</dl>
				</aside>
				<div class="prose">
					<p class="lede">{data.summary}</p>
					<Content />
				</div>
			</div>
		</article>
		{works.length > 0 && (
			<>
				<div class="section-head"><h2>Преведени текстове</h2></div>
				<div class="cards">{works.map((entry) => <Story entry={entry} variant="card" />)}</div>
			</>
		)}
	</div>
</Base>

---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Story from '../../components/Story.astro';
import { getTranslations } from '../../lib/utils';

export async function getStaticPaths() {
	const teachers = await getCollection('teachers');
	return teachers.map((teacher) => ({ params: { id: teacher.id }, props: { teacher } }));
}

const { teacher } = Astro.props;
const { data } = teacher;
const { Content } = await render(teacher);
const works = (await getTranslations()).filter((t) => t.data.teacher?.id === teacher.id);
---
<Base title={data.name} description={data.summary}>
	<div class="wrap">
		<article class="bio panel">
			<header class="bio-head">
				<span class="kicker">
					<a href="/uchiteli/">Учители</a>
					{data.tradition && <><span class="sep">|</span>{data.tradition}</>}
				</span>
				<h1>{data.name}</h1>
				<span class="date">{[data.dates, data.region].filter(Boolean).join(' · ')}</span>
			</header>
			<div class="prose">
				<p class="lede">{data.summary}</p>
				<Content />
			</div>
		</article>
		{works.length > 0 && (
			<>
				<h2 class="section-title">Преведени текстове</h2>
				<p class="section-sub">{works.length} {works.length === 1 ? 'превод' : 'превода'}</p>
				<div class="rows">{works.map((entry) => <Story entry={entry} variant="row" />)}</div>
			</>
		)}
	</div>
</Base>

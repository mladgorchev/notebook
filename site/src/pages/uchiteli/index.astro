---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import TeacherCard from '../../components/TeacherCard.astro';
import { getTranslations } from '../../lib/utils';

const teachers = (await getCollection('teachers')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'bg'));
const translations = await getTranslations();
const count = (id: string) => translations.filter((t) => t.data.teacher?.id === id).length;

const byTradition = new Map<string, typeof teachers>();
for (const t of teachers) {
	const key = t.data.tradition ?? 'Други';
	byTradition.set(key, [...(byTradition.get(key) ?? []), t]);
}
---
<Base title="Учители" description="Учителите и авторите, чиито текстове са преведени в Дхарма Слово.">
	<div class="wrap">
		<header class="page-head panel">
			<span class="kicker">Животописи</span>
			<h1>Учители</h1>
			<p>Учителите и авторите, чиито думи са преведени тук, подредени по традиция.</p>
		</header>
		{[...byTradition].map(([tradition, list]) => (
			<section>
				<h2 class="section-title" style="font-size:2rem;padding-top:36px">{tradition}</h2>
				<p class="section-sub"></p>
				<div class="teacher-grid">
					{list.map((t) => <TeacherCard teacher={t} count={count(t.id)} />)}
				</div>
			</section>
		))}
	</div>
</Base>

---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Cover from '../components/Cover.astro';
import TranslationCard from '../components/TranslationCard.astro';
import TeacherCard from '../components/TeacherCard.astro';
import Icon from '../components/Icon.astro';
import { excerptOf, formatDate, getTranslations, readingTime, slugify } from '../lib/utils';

const translations = await getTranslations();
const featured = translations.find((t) => t.data.featured) ?? translations[0];
const latest = translations.filter((t) => t !== featured).slice(0, 6);
const teachers = await getCollection('teachers');
const featuredTeacher = teachers.find((t) => t.id === featured?.data.teacher?.id);

const countBy = (pick: (t: (typeof translations)[number]) => string[]) => {
	const counts = new Map<string, number>();
	translations.forEach((t) => pick(t).forEach((k) => counts.set(k, (counts.get(k) ?? 0) + 1)));
	return counts;
};
const tags = [...countBy((t) => t.data.tags)].sort((a, b) => b[1] - a[1]).slice(0, 14);
const perTeacher = countBy((t) => (t.data.teacher ? [t.data.teacher.id] : []));
---
<Base>
	<section class="hero">
		<div class="wrap">
			<div class="hero-intro">
				<span class="eyebrow">Будистки текстове на български</span>
				<h1>Думите на Дхармата, преведени с грижа.</h1>
				<p>Сутри, учения и коментари от различни традиции, преведени на български език и достъпни свободно за всички.</p>
			</div>

			{featured && (
				<a class="feature" href={`/${featured.id}/`}>
					<div class="feature-body">
						<span class="eyebrow">Препоръчан превод{featured.data.tradition && ` · ${featured.data.tradition}`}</span>
						<h2>{featured.data.title}</h2>
						<p>{excerptOf(featured, 220)}</p>
						<div class="meta">
							{featuredTeacher && <span>{featuredTeacher.data.name}</span>}
							{featuredTeacher && <span class="dot" />}
							<span>{formatDate(featured.data.date)}</span>
							<span class="dot" />
							<span>{readingTime(featured.body)} мин четене</span>
						</div>
						<span><span class="btn btn-primary">Започни да четеш <Icon name="arrow-right" size={16} /></span></span>
					</div>
					<Cover title={featured.data.title} tradition={featured.data.tradition} image={featured.data.cover} />
				</a>
			)}
		</div>
	</section>

	<section class="section">
		<div class="wrap">
			<div class="section-head">
				<h2>Последни преводи</h2>
				<a class="btn" href="/prevodi/">Всички <Icon name="arrow-right" size={16} /></a>
			</div>
			<div class="grid">
				{latest.map((entry) => <TranslationCard entry={entry} />)}
			</div>
		</div>
	</section>

	<section class="section">
		<div class="wrap two-col">
			<div>
				<div class="section-head">
					<h2>Учители</h2>
					<a class="btn" href="/uchiteli/">Всички <Icon name="arrow-right" size={16} /></a>
				</div>
				<div class="teacher-grid">
					{teachers.slice(0, 6).map((t) => <TeacherCard teacher={t} count={perTeacher.get(t.id) ?? 0} />)}
				</div>
			</div>
			<aside class="panel">
				<span class="eyebrow">Разгледай по тема</span>
				<h3 style="font-size:1.6rem;margin:8px 0 18px">Теми</h3>
				<div class="pill-row">
					{tags.map(([tag, n]) => (
						<a class="pill" href={`/temi/${slugify(tag)}/`}>{tag} <span class="count">{n}</span></a>
					))}
				</div>
			</aside>
		</div>
	</section>
</Base>

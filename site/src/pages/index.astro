---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Story from '../components/Story.astro';
import { getTranslations, slugify } from '../lib/utils';
import { verses } from '../data/verses';

const translations = await getTranslations();
const featured = translations.find((t) => t.data.featured) ?? translations[0];
const rest = translations.filter((t) => t !== featured);
const seconds = rest.slice(0, 2);
const headlines = rest.slice(2, 6);
const rows = rest.slice(0, 5);
const teachers = (await getCollection('teachers')).sort((a, b) => a.data.name.localeCompare(b.data.name, 'bg'));
const count = (id: string) => translations.filter((t) => t.data.teacher?.id === id).length;

const tagCounts = new Map<string, number>();
translations.forEach((t) => t.data.tags.forEach((tag) => tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1)));
const tags = [...tagCounts].sort((a, b) => b[1] - a[1]).slice(0, 16);
const verse = verses[0];
---
<Base>
	<div class="wrap">
		<section class="lead">
			<div class="lead-main panel">
				{featured && <Story entry={featured} variant="lead" />}
				<div class="second-stack">
					{seconds.map((entry) => <Story entry={entry} variant="second" />)}
				</div>
			</div>
			<aside class="headlines panel">
				{headlines.map((entry) => <Story entry={entry} variant="headline" />)}
				<a class="btn" href="/prevodi/">Виж още</a>
			</aside>
		</section>

		<section class="verse-row">
			<figure class="verse" id="verse" style="margin:0" data-verses={JSON.stringify(verses)}>
				<span class="verse-tab">Стих на деня</span>
				<span class="verse-mark" aria-hidden="true">“</span>
				<blockquote>{verse.text}</blockquote>
				<figcaption>– <a href={verse.href}>{verse.source}</a></figcaption>
			</figure>
			<aside class="side-box panel">
				<h2>Учители</h2>
				<span class="date">Автори на преведените текстове</span>
				<ul class="side-list">
					{teachers.slice(0, 5).map((t) => (
						<li>
							<a href={`/uchiteli/${t.id}/`}>
								<strong>{t.data.name}</strong>
								<span>{t.data.tradition} · {count(t.id)} {count(t.id) === 1 ? 'превод' : 'превода'}</span>
							</a>
						</li>
					))}
				</ul>
				<a class="btn" href="/uchiteli/">Всички учители</a>
				<a class="btn btn-solid" href="/temi/">Разгледай по тема</a>
			</aside>
		</section>

		<h2 class="section-title">Преводи</h2>
		<p class="section-sub">Сутри, учения и коментари, преведени на български</p>
		<div class="rows">
			{rows.map((entry) => <Story entry={entry} variant="row" />)}
		</div>
		<div class="btn-row"><a class="btn btn-plum" href="/prevodi/">Всички преводи</a></div>

		<hr class="section-rule" />
		<h2 class="section-title">Теми</h2>
		<p class="section-sub">Разгледайте преводите по тема</p>
		<div class="topic-list panel">
			{tags.map(([tag, n]) => <a href={`/temi/${slugify(tag)}/`}>{tag}<span class="count">{n}</span></a>)}
		</div>
	</div>
</Base>

<script>
	// Pick a passage by day of the year, so it changes daily without rebuilding.
	const box = document.getElementById('verse')!;
	const verses = JSON.parse(box.dataset.verses!);
	const start = new Date(new Date().getFullYear(), 0, 0).getTime();
	const day = Math.floor((Date.now() - start) / 86400000);
	const v = verses[day % verses.length];
	box.querySelector('blockquote')!.textContent = v.text;
	const link = box.querySelector('figcaption a') as HTMLAnchorElement;
	link.textContent = v.source;
	link.href = v.href;
</script>

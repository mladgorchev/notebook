---
import type { GetStaticPaths, Page } from 'astro';
import Base from '../../layouts/Base.astro';
import Story from '../../components/Story.astro';
import Pagination from '../../components/Pagination.astro';
import { getTranslations, type Translation } from '../../lib/utils';

export const getStaticPaths = (async ({ paginate }) => {
	return paginate(await getTranslations(), { pageSize: 10 });
}) satisfies GetStaticPaths;

const { page } = Astro.props as { page: Page<Translation> };
---
<Base title="Преводи">
	<div class="wrap">
		<header class="page-head panel">
			<span class="kicker">Библиотека</span>
			<h1>Преводи</h1>
			<p>{page.total} текста, подредени от най-новия. Разгледайте ги и по <a href="/uchiteli/">учител</a> или по <a href="/temi/">тема</a>.</p>
		</header>
		<div class="rows" style="margin-top:20px">
			{page.data.map((entry) => <Story entry={entry} variant="row" />)}
		</div>
		<Pagination current={page.currentPage} last={page.lastPage} base="/prevodi/" />
	</div>
</Base>
